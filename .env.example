CLICKUP_WEBHOOK_SECRET=
CLICKUP_API_TOKEN=
DATABASE_PATH=clickup_notfy.db
API_BEARER_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_REMETENTE=
FALLBACK_EMAIL=

# Usado só em produção (docker-compose.prod.yml) - dominio publico que
# aponta (registro DNS A) pro IP do servidor, ex: notify.empresa.com.br.
# O Caddy usa isso pra emitir o certificado HTTPS automaticamente.
DOMAIN=

# Só necessário se a porta 443 externa não estiver disponível e o
# Caddy precisar validar o certificado via desafio DNS em vez de HTTP
# (ver ADR-0010 "Porta 443 externa indisponível"). Token de API do
# provedor de DNS do domínio - preencher assim que a infra confirmar
# qual é o provedor.
# DNS_API_TOKEN=

# ADR-0011 - alerta operacional: destinatarios avisados quando o PROPRIO
# servico pode estar com problema (falha nao tratada ao processar um
# evento, ou webhook do ClickUp perto do limite de falhas que leva a
# suspensao automatica). Diferente do FALLBACK_EMAIL acima, que e sobre
# o conteudo normal de notificacao de chamado.
# Lista separada por virgula, ex: admin1@empresa.com,admin2@empresa.com
# Deixar vazio desativa esse alerta (o servico funciona normalmente sem ele).
EMAILS_ALERTA_OPERACIONAL=

# Necessarios so para o alerta de webhook perto do limite de falhas
# (ver CLICKUP_WEBHOOK_ID). Sem esses dois, esse alerta especifico fica
# desativado, mas o alerta de falha de processamento continua funcionando.
CLICKUP_TEAM_ID=
CLICKUP_WEBHOOK_ID=

# A partir de quantas falhas de entrega registradas pelo ClickUp
# (campo health.fail_count) o alerta acima dispara. O ClickUp nao publica
# o limite oficial que leva a suspensao automatica - 20 e um valor
# conservador escolhido apos observar suspensao real com fail_count=101.
LIMITE_FAIL_COUNT_ALERTA=20
